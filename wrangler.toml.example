name = "__WORKER_NAME__"
main = "src/index.js"
compatibility_date = "2026-02-14"

# 禁用指标发送
send_metrics = false

# D1 数据库绑定
[[d1_databases]]
binding = "DB"
database_name = "vn-shelf-db"
database_id = "__D1_DATABASE_ID__"

# Queue生产者（批量索引）
[[queues.producers]]
queue = "vn-index-queue"
binding = "VN_INDEX_QUEUE" # 不要修改此项

# Queue消费者（批量索引处理）
[[queues.consumers]]
queue = "vn-index-queue"
max_batch_size = 1
max_batch_timeout = 1

# Durable Object 绑定（索引启动原子锁）
[[durable_objects.bindings]]
name = "INDEX_START_LOCK" # 不要修改此项
class_name = "IndexStartLockDurableObject"

# Durable Object 绑定（登录限流，每 IP 一实例）
[[durable_objects.bindings]]
name = "LOGIN_RATE_LOCK" # 不要修改此项
class_name = "LoginRateLimiterDurableObject"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["IndexStartLockDurableObject"]

# 新增 DO 类必须追加新 tag（Workers 迁移 tag 不可变，v1 已被索引锁占用）
[[migrations]]
tag = "v2"
new_sqlite_classes = ["LoginRateLimiterDurableObject"]

# Worker Assets 配置（静态资源）
[assets]
directory = "./public"
binding = "ASSETS" # 不要修改此项
html_handling = "auto-trailing-slash"

# 开启 observability
[observability]
enabled = true
head_sampling_rate = 1

# 环境变量
[vars]
# 本地开发时由 .dev.vars 覆盖为 development（wrangler dev 自动读取 .dev.vars）
ENVIRONMENT = "production"