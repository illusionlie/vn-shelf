  "cards": [
    {
      "dot": "cyan",
      "title": "同步请求路径",
      "items": [
        "非 /api 请求优先命中 Worker Assets 静态资源，失败回退路由",
        "受保护接口经 auth.js 校验 JWT（24h httpOnly Cookie）",
        "router.js 分发全部 REST 端点，repository.js 统一访问 D1"
      ]
    },
    {
      "dot": "emerald",
      "title": "异步索引管线",
      "items": [
        "index-task.js 分批投递 Queue（每批 ≤25，消费 batch=1）",
        "queue() 拉取 VNDB 后幂等写入 index_task_items，重试 ≤3 次间隔 60s",
        "临近完成即时汇总，其余走 waitUntil 延迟汇总（≤6 次 × 5s）"
      ]
    },
    {
      "dot": "amber",
      "title": "外部集成与互斥",
      "items": [
        "VNDB：fetchVNDB 内置 3 次指数退避；/api/vndb/search 搜索代理、refreshVNDB、ulist 分页导入",
        "IndexStartLockDurableObject 全局锁防并发启动，TTL 30s 自动过期",
        "密钥（VNDB Token / 密码哈希 / JWT Secret）存于 D1 settings，不下发前端"
      ]
    }
  ]
